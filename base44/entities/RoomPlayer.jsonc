{
  "name": "RoomPlayer",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "membership_capability_hash": {
      "type": "string",
      "description": "SHA-256 verifier for this player's server-issued membership capability.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "nickname": {
      "type": "string"
    },
    "avatar_id": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "is_host": {
      "type": "boolean",
      "default": false
    },
    "connected": {
      "type": "boolean",
      "default": true
    },
    "last_seen": {
      "type": "string"
    }
  },
  "required": [
    "room_code",
    "session_id"
  ],
  "rls": {
    // Rosters are returned only by the room backend after capability
    // validation. This prevents direct enumeration of player/session data.
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
