{
  "name": "Room",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "lobby",
        "playing",
        "closed"
      ],
      "default": "lobby"
    },
    "mode": {
      "type": "string",
      "enum": [
        "family",
        "adult"
      ],
      "default": "family"
    },
    "length": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "party",
        "endless"
      ],
      "default": "standard"
    },
    "host_session": {
      "type": "string",
      "description": "Host identity; returned only by the capability-validated room function.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "creator_capability_hash": {
      "type": "string",
      "description": "SHA-256 verifier for the pending creator capability; never exposed to anonymous clients.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "max_players": {
      "type": "integer",
      "default": 8
    },
    "game_state": {
      "type": "object"
    }
  },
  "required": [
    "code",
    "host_session"
  ],
  "rls": {
    // The current anonymous SDK subscription uses Room only as a shared
    // display-state feed. All mutations remain service-role-only, and the
    // capability verifier above is field-private even on realtime events.
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
